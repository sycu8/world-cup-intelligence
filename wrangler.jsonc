{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Default environment: UAT (npm run deploy / deploy:uat)
  "name": "wc-tactical-uat",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Observability stays off. Drain progress is ingestStaleDrops on /api/health.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/matches/*",
      "/api/*",
      "/.well-known/*",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt",
      "/auth.md",
      "/docs/api.md",
      "/oauth/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "uat",
    "MOCK_SOURCES": "false",
    "FIFA_LIVE_ENABLED": "true",
    "PUBLIC_API_REQUIRE_KEY": "false",
    "AI_FALLBACK_MODE": "false",
    "VECTORIZE_FALLBACK_MODE": "true",
    "AI_GATEWAY_ENABLED": "true",
    "AI_GATEWAY_ID": "wc-tactical",
    "CORS_ORIGINS": "*",
    "AI_CALLS_PER_RUN": "20",
    "AI_CALLS_PER_MINUTE": "30"
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "413d9f3be91046c883fb42fc5c99b0d7" }
  ],
  "r2_buckets": [
    { "binding": "R2_RAW", "bucket_name": "wc-tactical-raw-uat" },
    { "binding": "R2_SNAPSHOTS", "bucket_name": "wc-tactical-snapshots-uat" },
    { "binding": "R2_ARTIFACTS", "bucket_name": "wc-tactical-artifacts-uat" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wc-tactical-db-uat-v2",
      "database_id": "8cdc6c74-3521-4ebc-a3ac-dbfd0126eaef",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "wc-ingest-queue-uat" },
      { "binding": "MODEL_QUEUE", "queue": "wc-model-queue-uat" }
    ],
    "consumers": [
      {
        "queue": "wc-ingest-queue-uat",
        "max_batch_size": 10,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "wc-ingest-dlq-uat"
      },
      // Explicit DLQ consumer. One retry, then the message is discarded. No nested DLQ.
      {
        "queue": "wc-ingest-dlq-uat",
        "max_batch_size": 10,
        "max_retries": 1,
        "max_concurrency": 1
      },
      {
        "queue": "wc-model-queue-uat",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "wc-model-dlq-uat",
        // Approved by Cuong. Default first retry wait. Explicit retries grow 10/30/90/300s.
        "retry_delay": 10,
        // Approved by Cuong. Briefing code works with concurrency 1.
        "max_concurrency": 2
      },
      {
        "queue": "wc-model-dlq-uat",
        "max_batch_size": 10,
        "max_retries": 1,
        "max_concurrency": 1
      }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }],
  // UAT score refresh runs every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *", "*/15 * * * *", "0 3 * * 1"]
  },
  "env": {
    "production": {
      "name": "wc-tactical-probability-platform",
      "workers_dev": false,
      "preview_urls": false,
      // wcstat.orangecloud.vn is bound via Workers Domains (account API).
      // Omit routes here — Zone Workers Routes permission is not required for deploy.
      "vars": {
        "ENVIRONMENT": "production",
        "MOCK_SOURCES": "false",
    "FIFA_LIVE_ENABLED": "true",
    "PUBLIC_API_REQUIRE_KEY": "true",
        "AI_FALLBACK_MODE": "false",
        "VECTORIZE_FALLBACK_MODE": "true",
        "AI_GATEWAY_ENABLED": "true",
        "AI_GATEWAY_ID": "wc-tactical",
        "CORS_ORIGINS": "*",
        "AI_CALLS_PER_RUN": "40",
        "AI_CALLS_PER_MINUTE": "80"
      },
      "kv_namespaces": [
        { "binding": "KV", "id": "fe99c19c60a542ea9771111b5ae050da" }
      ],
      "r2_buckets": [
        { "binding": "R2_RAW", "bucket_name": "wc-tactical-raw" },
        { "binding": "R2_SNAPSHOTS", "bucket_name": "wc-tactical-snapshots" },
        { "binding": "R2_ARTIFACTS", "bucket_name": "wc-tactical-artifacts" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wc-tactical-db",
          "database_id": "9571e8df-797c-4f45-890b-dbb01174dee3",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [
          { "binding": "INGEST_QUEUE", "queue": "wc-ingest-queue" },
          { "binding": "MODEL_QUEUE", "queue": "wc-model-queue" }
        ],
        "consumers": [
          {
            "queue": "wc-ingest-queue",
            "max_batch_size": 10,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "wc-ingest-dlq"
          },
          // Explicit DLQ consumer. One retry, then the message is discarded. No nested DLQ.
          {
            "queue": "wc-ingest-dlq",
            "max_batch_size": 10,
            "max_retries": 1,
            "max_concurrency": 1
          },
          {
            "queue": "wc-model-queue",
            "max_batch_size": 5,
            "max_retries": 3,
            "dead_letter_queue": "wc-model-dlq",
            // Approved by Cuong. Default first retry wait. Explicit retries grow 10/30/90/300s.
            "retry_delay": 10,
            // Approved by Cuong. Briefing code works with concurrency 1.
            "max_concurrency": 2
          },
          {
            "queue": "wc-model-dlq",
            "max_batch_size": 10,
            "max_retries": 1,
            "max_concurrency": 1
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }]
      },
      // Production score refresh runs every minute.
      "triggers": {
        "crons": ["* * * * *", "*/15 * * * *", "0 3 * * 1"]
      }
    }
  }
}
