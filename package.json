{
  "name": "world-cup-intelligence",
  "version": "1.0.0",
  "description": "PitchIntel — FIFA World Cup 2026 tactical probability & news intelligence on Cloudflare",
  "repository": {
    "type": "git",
    "url": "https://github.com/sycu8/world-cup-intelligence.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:uat": "wrangler dev",
    "build": "vite build",
    "pull:statsbomb": "node scripts/pull-statsbomb-open-data.mjs",
    "pull:statsbomb:local": "node scripts/pull-statsbomb-open-data.mjs --local",
    "sync:fifa-schedule": "node scripts/fetch-fifa-wc2026-calendar.mjs && node scripts/generate-fifa-kickoff-migration.mjs && node scripts/generate-fifa-results-migration.mjs",
    "test": "vitest run",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage/.tmp',{recursive:true})\" && vitest run --coverage --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:scenarios": "node scripts/run-capability-scenarios.mjs",
    "test:scenarios:streak": "node scripts/run-scenario-streak.mjs",
    "validate:knockout": "node scripts/validate-knockout-probabilities.mjs",
    "test:seo": "vitest run tests/seo-geo-audit.integration.test.ts tests/spaSeoMeta.test.ts",
    "test:seo:crawl": "node scripts/run-seo-geo-audit.mjs",
    "test:perf": "node scripts/measure-page-load.mjs",
    "backtest:scores": "vitest run tests/scorelineMetrics.test.ts tests/offlineBacktest.test.ts",
    "calibrate:model": "node scripts/calibrate-probability-model.mjs",
    "warm:caches": "node scripts/warm-production-caches.mjs",
    "lint": "eslint src app --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "deploy": "npm run deploy:uat",
    "deploy:uat": "npm run build && node scripts/wrangler-with-env.mjs deploy --config dist/wc_tactical_uat/wrangler.json",
    "deploy:production": "npm run build && node scripts/wrangler-with-env.mjs deploy --config wrangler.jsonc --env production",
    "deploy:both": "npm run db:migrate:uat && npm run deploy:uat && npm run db:migrate:production && npm run deploy:production",
    "db:migrate:local": "node scripts/wrangler-with-env.mjs d1 migrations apply wc-tactical-db-uat-v2 --local",
    "db:migrate:remote": "node scripts/wrangler-with-env.mjs d1 migrations apply wc-tactical-db --remote",
    "db:migrate:uat": "node scripts/wrangler-with-env.mjs d1 migrations apply wc-tactical-db-uat-v2 --remote",
    "db:migrate:production": "node scripts/wrangler-with-env.mjs d1 migrations apply wc-tactical-db --remote --env production",
    "db:prune:snapshots:uat": "node scripts/prune-probability-snapshots.mjs --remote --keep-latest",
    "db:prune:snapshots:production": "node scripts/prune-probability-snapshots.mjs --remote --production --keep-latest",
    "seed": "node scripts/wrangler-with-env.mjs d1 execute wc-tactical-db-uat-v2 --local --file=./migrations/0003_seed_reference.sql",
    "bootstrap:local-qa": "bash scripts/bootstrap-local-qa.sh",
    "test:qa-local": "node scripts/run-local-qa-inventory.mjs",
    "worker:dev": "wrangler dev",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.12.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.41.0",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.14.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "undici": "^7.28.0"
  }
}
